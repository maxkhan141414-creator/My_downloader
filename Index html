        // ──────────────────────────────────────────
        // SINGLE API CALLER — ek baar mein sirf EK API
        // 2-3 second timeout, fail hone par agli try hoti hai
        // ──────────────────────────────────────────
        async function callOneApi(config, link) {
            const controller = new AbortController();
            const timeout    = getRandomTimeout(); // 2000-3000ms
            const timeoutId  = setTimeout(() => controller.abort(), timeout);

            try {
                const fetchOptions = {
                    method:  config.method,
                    headers: config.headers,
                    signal:  controller.signal
                };
                if (config.method === "POST" && config.body) {
                    fetchOptions.body = config.body;
                }

                const response = await fetch(config.url, fetchOptions);
                clearTimeout(timeoutId);

                // HTTP error (4xx, 5xx) — is API ne kaam nahi kiya, agle par jao
                if (!response.ok) {
                    console.log(`⚠️ ${config.name} → HTTP ${response.status} — skipping`);
                    return null;
                }

                const result = await response.json();
                const parsed = config.parse(result);

                // Parse hua aur URL mila — SUCCESS
                if (parsed && parsed.url && parsed.url.startsWith("http")) {
                    console.log(`✅ ${config.name} → SUCCESS`);
                    return parsed;
                }

                // Response aaya par video URL nahi mila
                console.log(`⚠️ ${config.name} → No video URL in response — skipping`);
                return null;

            } catch (err) {
                clearTimeout(timeoutId);
                if (err.name === 'AbortError') {
                    console.log(`⏱️ ${config.name} → Timeout (2-3s) — next API try ho rahi hai`);
                } else {
                    console.log(`❌ ${config.name} → Error: ${err.message} — skipping`);
                }
                return null;
            }
        }

        async function startDownload() {
            // Pehle internet check karo
            if (!checkInternet()) return;

            const link = document.getElementById('videoLink').value.trim();

            if (!link) {
                alert('कृपया पहले वीडियो का लिंक पेस्ट करें!');
                return;
            }

            if (!isValidUrl(link)) {
                alert('यह एक मान्य Instagram/Facebook लिंक नहीं है।');
                return;
            }

            const btnText   = document.getElementById('btnText');
            const btnIcon   = document.getElementById('btnIcon');
            const btnLoader = document.getElementById('btnLoader');
            const resultBox = document.getElementById('resultBox');
            const mainBtn   = document.getElementById('mainBtn');

            // UI lock karo — user dobara press na kare
            mainBtn.disabled        = true;
            btnIcon.style.display   = "none";
            btnLoader.style.display = "inline-block";
            resultBox.style.display = "none";
            btnText.innerText       = "शुरू हो रहा है... 🚀";

            const apiConfigs = getApiConfigs(link);
            const total      = apiConfigs.length;
            let   videoData  = null;

            // ── EK KE BAAD EK — sequential chain ──
            // Jab tak video nahi milta ya sari APIs khatam nahi ho jaati
            for (let i = 0; i < total; i++) {
                const config = apiConfigs[i];

                // Internet beech mein band ho gaya?
                if (!navigator.onLine) {
                    document.getElementById('noInternetOverlay').classList.add('show');
                    resetBtn(btnText, btnIcon, btnLoader, mainBtn);
                    return;
                }

                // User ko dikhao konsi API try ho rahi hai
                btnText.innerText = `API ${i + 1}/${total} try ho rahi hai...`;

                // Sirf YEH ek API call karo — dusri wait karegi
                videoData = await callOneApi(config, link);

                // Mil gayi! Loop todke result dikhao
                if (videoData) break;

                // Nahi mili — loop apne aap agli API par jayega
            }

            // UI unlock karo
            resetBtn(btnText, btnIcon, btnLoader, mainBtn);

            if (videoData && videoData.url) {
                fetchedVideoUrl   = videoData.url;
                fetchedVideoImg   = videoData.img || "";
                currentVideoTitle = videoData.title || "Social_Video_" + Date.now();

                const titleEl     = document.getElementById('videoTitleDisplay');
                titleEl.innerText = currentVideoTitle.substring(0, 45) + (currentVideoTitle.length > 45 ? "..." : "");

                resultBox.style.display                        = "block";
                document.getElementById('galleryBtn').innerText = "⬇️ सीधे गैलरी में सेव करें ⬇️";
                document.getElementById('galleryBtn').disabled  = false;
                document.getElementById('progressContainer').style.display = "none";
            } else {
                alert("❌ सभी 12 APIs fail हो गईं। कृपया लिंक दोबारा चेक करें।");
            }
        }

        // Button ko wapas normal state mein laao
        function resetBtn(btnText, btnIcon, btnLoader, mainBtn) {
            btnText.innerText       = "DOWNLOAD VIDEO";
            btnIcon.style.display   = "inline-block";
            btnLoader.style.display = "none";
            mainBtn.disabled        = false;
        }

