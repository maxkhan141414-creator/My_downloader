        // ──────────────────────────────────────────
        // ACTUAL DOWNLOAD FUNCTION
        // ──────────────────────────────────────────
        async function downloadToGallery() {
            if (!fetchedVideoUrl) return;

            const galleryBtn        = document.getElementById('galleryBtn');
            const progressContainer = document.getElementById('progressContainer');
            const progressBar       = document.getElementById('progressBar');

            galleryBtn.innerText    = "डाउनलोड हो रहा है...";
            galleryBtn.disabled     = true;
            progressContainer.style.display = "block";
            progressBar.style.width = "10%";

            const safeTitle = currentVideoTitle.replace(/[^a-zA-Z0-9]/g, "_") + ".mp4";

            try {
                progressBar.style.width = "30%";
                const response = await fetch(fetchedVideoUrl);
                progressBar.style.width = "70%";
                const blob    = await response.blob();
                const blobUrl = URL.createObjectURL(blob);

                progressBar.style.width = "90%";
                const a      = document.createElement('a');
                a.href       = blobUrl;
                a.download   = safeTitle;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                setTimeout(() => URL.revokeObjectURL(blobUrl), 3000);

                progressBar.style.width = "100%";
                galleryBtn.innerText    = "✅ डाउनलोड हो गया!";
                saveToHistory(currentVideoTitle, fetchedVideoUrl, fetchedVideoImg);

            } catch (error) {
                progressBar.style.width = "80%";
                const a    = document.createElement('a');
                a.href     = fetchedVideoUrl;
                a.download = safeTitle;
                a.target   = "_blank";
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);

                progressBar.style.width = "100%";
                galleryBtn.innerText    = "✅ डाउनलोड शुरू!";
                saveToHistory(currentVideoTitle, fetchedVideoUrl, fetchedVideoImg);
            }

            setTimeout(() => {
                progressContainer.style.display = "none";
                galleryBtn.disabled             = false;
            }, 2000);
        }

        // ──────────────────────────────────────────
        // HISTORY SYSTEMS
        // ──────────────────────────────────────────
        function saveToHistory(name, url, img) {
            try {
                let history = JSON.parse(localStorage.getItem("downloader_history") || "[]");
                if (history.some(h => h.url === url)) return;
                if (history.length >= 20) history.pop();
                history.unshift({ name, url, img, platform: currentPlatform });
                localStorage.setItem("downloader_history", JSON.stringify(history));
                loadHistory();
            } catch(e) {}
        }

        function loadHistory() {
            const grid = document.getElementById("recentGrid");
            grid.innerHTML = "";

            let history = [];
            try {
                history = JSON.parse(localStorage.getItem("downloader_history") || "[]");
            } catch(e) { history = []; }

            if (history.length === 0) {
                grid.innerHTML = `<p style="grid-column: span 4; text-align: center; color: #64748b; font-size: 11px; padding: 20px;">कोई वीडियो नहीं है</p>`;
                return;
            }

            history.forEach(item => {
                const itemBtn   = document.createElement("a");
                itemBtn.href    = item.url;
                itemBtn.target  = "_blank";
                itemBtn.className = "recent-item";
                itemBtn.title   = item.name;

                if (item.img) {
                    itemBtn.innerHTML = `<img src="${item.img}" alt="Thumb" onerror="this.style.display='none'"><span>${item.name.substring(0, 10)}...</span>`;
                } else {
                    itemBtn.innerHTML = `<i class="fa-solid fa-video"></i><span>${item.name.substring(0, 10)}...</span>`;
                }
                grid.appendChild(itemBtn);
            });
        }

        function clearHistory() {
            if (confirm("क्या आप सारी हिस्ट्री डिलीट करना चाहते हैं?")) {
                try {
                    localStorage.removeItem("downloader_history");
                } catch(e) {}
                loadHistory();
            }
        }
